<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WikiFlerty" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Selection handles in the book use the phone's accent color (see values-v31). -->
    <style name="Theme.WikiFlerty.Reader" parent="Theme.WikiFlerty">
        <item name="colorPrimary">@color/selection_accent</item>
        <item name="colorControlActivated">@color/selection_accent</item>
        <item name="android:colorControlActivated">@color/selection_accent</item>
        <item name="android:colorAccent">@color/selection_accent</item>
        <item name="android:textColorHighlight">@color/selection_highlight</item>
    </style>
</resources>
