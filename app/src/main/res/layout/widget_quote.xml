<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quote_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/quote_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_quote_title"
        android:scaleType="fitXY"
        android:src="@drawable/widget_preview_quote" />

    <ImageView
        android:id="@+id/quote_next"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp"
        android:contentDescription="@string/widget_quote_next"
        android:padding="10dp"
        android:src="@drawable/ic_widget_refresh"
        android:visibility="gone" />
</FrameLayout>
