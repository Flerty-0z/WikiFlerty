<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quote_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_quote_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/widget_mark"
            android:fontFamily="serif"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingTop="4dp"
            android:text="“"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/widget_quote_title"
            android:textColor="#D9772A"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/quote_next"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/widget_quote_next"
            android:padding="5dp"
            android:src="@drawable/ic_widget_refresh" />
    </LinearLayout>

    <TextView
        android:id="@+id/quote_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:lineSpacingMultiplier="1.15"
        android:maxLines="5"
        android:textColor="#F2EBE1"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/quote_cover"
            android:layout_width="26dp"
            android:layout_height="38dp"
            android:background="@drawable/widget_cover_bg"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/quote_book"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#F2EBE1"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/quote_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#8E8273"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/quote_open"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/widget_pill"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/widget_quote_open"
            android:textColor="#D9772A"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
