<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reader_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.flerty.wikiflerty.reader.StableFrameLayout
        android:id="@+id/book_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="46dp">

        <FrameLayout
            android:id="@+id/page_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/navigator_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.flerty.wikiflerty.reader.PageTextureView
                android:id="@+id/page_texture"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:visibility="gone" />

            <com.flerty.wikiflerty.reader.RibbonView
                android:id="@+id/page_ribbon"
                android:layout_width="16dp"
                android:layout_height="28dp"
                android:layout_gravity="top|end"
                android:layout_marginEnd="22dp"
                android:importantForAccessibility="no"
                android:visibility="invisible" />
        </FrameLayout>

        <ImageView
            android:id="@+id/page_snapshot"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:visibility="gone" />

        <com.flerty.wikiflerty.reader.ChapterShiftView
            android:id="@+id/chapter_shift"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />
    </com.flerty.wikiflerty.reader.StableFrameLayout>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/reader_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
